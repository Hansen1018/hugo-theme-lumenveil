{{- $pages := where site.RegularPages "Section" "in" site.Params.mainSections -}}
[
{{- range $index, $page := $pages -}}
{{- if $index }},{{ end -}}
{{- dict "title" $page.Title "url" $page.RelPermalink "description" ($page.Description | default ($page.Summary | plainify)) "content" ($page.Plain | truncate 600) "tags" ($page.Params.tags | default slice) "date" ($page.Date.Format "2006-01-02") | jsonify -}}
{{- end -}}
]
